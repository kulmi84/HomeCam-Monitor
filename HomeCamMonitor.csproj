<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HomeCamMonitor</AssemblyName>
    <RootNamespace>HomeCamMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\HomeCamMonitor.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);BETA;RELEASE_V1</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/HomeCamMonitor.ico" LogicalName="HomeCamMonitor.ApplicationIcon" />
    <EmbeddedResource Include="assets/homecam-monitor-logo.png" LogicalName="HomeCamMonitor.OfflineLogo" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
