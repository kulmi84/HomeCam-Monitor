<Project>
  <PropertyGroup>
    <HomeCamV2Version>2.0.16.0</HomeCamV2Version>
    <!-- Generated installer sources and package contents are never app sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/v2-release-downloads/**;**/publish-v2-release/**;**/reolink-component-cache/**;**/store-artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
