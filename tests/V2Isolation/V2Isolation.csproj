<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(StoreRelease)' == 'true'">net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>BETA;V2_BETA</DefineConstants>
    <DefineConstants Condition="'$(NextBeta)' == 'true'">$(DefineConstants);NEXT_BETA</DefineConstants>
    <DefineConstants Condition="'$(StoreRelease)' == 'true'">$(DefineConstants);STORE_PACKAGE</DefineConstants>
    <DefineConstants Condition="'$(FinalRelease)' == 'true'">$(DefineConstants);RELEASE_V2</DefineConstants>
    <Version Condition="'$(FinalRelease)' == 'true'">$(HomeCamV2Version)</Version>
    <StartupObject>V2Isolation.Check</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../assets/homecam-icon-White.ico" TargetPath="HomeCam-Weiss-transparent.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/homecam-icon-Black.ico" TargetPath="HomeCam-Schwarz-transparent.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../assets/homecam-logo-Default.png" LogicalName="HomeCamMonitor.Logo.Default" />
    <EmbeddedResource Include="../../assets/homecam-icon-Default.ico" LogicalName="HomeCamMonitor.Icon.Default" />
    <EmbeddedResource Include="../../assets/homecam-logo-White.png" LogicalName="HomeCamMonitor.Logo.White" />
    <EmbeddedResource Include="../../assets/homecam-icon-White.ico" LogicalName="HomeCamMonitor.Icon.White" />
    <EmbeddedResource Include="../../assets/homecam-logo-Black.png" LogicalName="HomeCamMonitor.Logo.Black" />
    <EmbeddedResource Include="../../assets/homecam-icon-Black.ico" LogicalName="HomeCamMonitor.Icon.Black" />

    <EmbeddedResource Include="../../assets/HomeCamMonitor-Beta.ico" LogicalName="HomeCamMonitor.ApplicationIcon" />
    <EmbeddedResource Include="../../assets/homecam-monitor-logo.png" LogicalName="HomeCamMonitor.OfflineLogo" />
    <EmbeddedResource Include="../../assets/Strings.en.tsv" LogicalName="HomeCamMonitor.Strings.en.tsv" WithCulture="false" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" ExcludeAssets="analyzers" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Compile Include="../../*.cs" />
    <Compile Include="Check.cs" />
    <Compile Include="DirectChecks.cs" />
    <Compile Include="UidPlaybackChecks.cs" />
    <Compile Include="DiscoveryChecks.cs" />
    <Compile Include="HomeAssistantChecks.cs" />
    <Compile Include="LocalMotionChecks.cs" />
    <Compile Include="DocumentationScreenshots.cs" />
    <Compile Include="StoreScreenshots.cs" />
    <Compile Include="LocalizationChecks.cs" />
    <Compile Include="LogoVariantChecks.cs" />
    <Compile Include="StorageDefaultChecks.cs" />
    <Compile Include="NextBetaPresentationChecks.cs" />
    <Compile Include="RestorePlayerChecks.cs" />
  </ItemGroup>
  <!-- The package analyzer needs a newer Roslyn than this .NET 8 project. -->
  <Target Name="RemoveIncompatibleOpenCvAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
    <EmbeddedResource Include="../../assets/homecam-logo-Default.png" LogicalName="HomeCamMonitor.Logo.Default" />
    <EmbeddedResource Include="../../assets/homecam-icon-Default.ico" LogicalName="HomeCamMonitor.Icon.Default" />
    <EmbeddedResource Include="../../assets/homecam-logo-White.png" LogicalName="HomeCamMonitor.Logo.White" />
    <EmbeddedResource Include="../../assets/homecam-icon-White.ico" LogicalName="HomeCamMonitor.Icon.White" />
    <EmbeddedResource Include="../../assets/homecam-logo-Black.png" LogicalName="HomeCamMonitor.Logo.Black" />
    <EmbeddedResource Include="../../assets/homecam-icon-Black.ico" LogicalName="HomeCamMonitor.Icon.Black" />
<Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'OpenCvSharp.Analyzers'" /></ItemGroup>
  </Target>
</Project>
