<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>BETA</DefineConstants>
    <StartupObject>ToolbarRender.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/HomeCamMonitor-Beta.ico" LogicalName="HomeCamMonitor.ApplicationIcon" />
    <EmbeddedResource Include="../../assets/homecam-monitor-logo.png" LogicalName="HomeCamMonitor.OfflineLogo" />
    <Compile Include="../../Program.cs" />
    <Compile Include="../../MotionPreRoll.cs" />
    <Compile Include="../../RecordingStorage.cs" />
    <Compile Include="../../SettingsBackup.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
