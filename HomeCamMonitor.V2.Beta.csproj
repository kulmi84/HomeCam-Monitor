<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HomeCamMonitor-V2-Beta</AssemblyName>
    <RootNamespace>HomeCamMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\HomeCamMonitor-V2-Beta.ico</ApplicationIcon>
    <Version>2.0.0-beta.37</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);BETA;V2_BETA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" ExcludeAssets="analyzers" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="assets/HomeCamMonitor-V2-Beta.ico" LogicalName="HomeCamMonitor.ApplicationIcon" />
    <EmbeddedResource Include="assets/homecam-monitor-logo-default.png" LogicalName="HomeCamMonitor.OfflineLogo" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <!-- The package analyzer needs a newer Roslyn than this .NET 8 project. -->
  <Target Name="RemoveIncompatibleOpenCvAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup><Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'OpenCvSharp.Analyzers'" /></ItemGroup>
  </Target>
  <!-- Analysis uses the existing FFmpeg executable, not OpenCV videoio. -->
  <Target Name="RemoveUnusedOpenCvVideoPlugin" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" /></ItemGroup>
  </Target>
</Project>
