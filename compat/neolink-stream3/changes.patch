+        let message = video();
+        legacy_video_sender(&message, &consumers).unwrap().send(Ok(message)).await.unwrap();
+        assert_eq!(receiver.recv().await.unwrap().unwrap().meta.msg_num, 0);
+    }
+    #[tokio::test]
+    async fn legacy_video_never_guesses_between_streams_or_routes_other_channels_and_xml() {
+        let (one, _rx1) = channel(1);
+        let (two, rx2) = channel(1);
+        let mut consumers = BTreeMap::new();
+        consumers.insert(Some(42), one);
+        consumers.insert(Some(43), two);
+        assert!(legacy_video_sender(&video(), &consumers).is_none());
+        drop(rx2);
+        assert!(legacy_video_sender(&video(), &consumers).is_some());
+        let mut message = video();
+        message.meta.channel_id = 1;
+        assert!(legacy_video_sender(&message, &consumers).is_none());
+        message.meta.channel_id = 0;
+        message.body = BcBody::ModernMsg(ModernMsg::default());
+        assert!(legacy_video_sender(&message, &consumers).is_none());
+        message.body = BcBody::ModernMsg(ModernMsg { extension: None,
+            payload: Some(BcPayloads::BcXml(BcXml::default())) });
+        assert!(legacy_video_sender(&message, &consumers).is_none());
+        message.meta.msg_id = MSG_ID_LOGIN;
+        assert!(legacy_video_sender(&message, &consumers).is_none());
+    }
+}
