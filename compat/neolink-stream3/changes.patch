+        assert_eq!(frames, 400, "RTP output stopped or lost complete frames");
+        assert!(lag < 1_000_000_000, "Live timestamp lag grew beyond one second");
+        assert!(queued <= 500_000_000, "Live appsrc accumulated a backlog");
+        Ok(())
+    }
+
+    #[tokio::test(flavor = "multi_thread")]
+    #[ignore = "requires HOMECAM_LIVE_SAMPLE, HOMECAM_MPV and GStreamer"]
+    async fn live_rtsp_factory_reaches_real_player() -> AnyResult<()> {
+        gstreamer::init()?;
+        let frame = Arc::new(std::fs::read(std::env::var("HOMECAM_LIVE_SAMPLE")?)?);
+        let listener = std::net::TcpListener::bind("127.0.0.1:0")?;
+        let port = listener.local_addr()?.port(); drop(listener);
+        let server = gstreamer_rtsp_server::RTSPServer::new();
+        server.set_address("127.0.0.1"); server.set_service(&port.to_string());
+        let (factory, mut clients) = make_factory(&StreamConfig { resolution: [640, 360], vid_format: VidFormat::H264, aud_format: AudFormat::None }).await?;
+        factory.add_permitted_roles(&HashSet::from(["anonymous"]));
+        server.mount_points().unwrap().add_factory("/test", factory);
+        let id = server.attach(None)?;
+        let main_loop = gstreamer::glib::MainLoop::new(None, false);
+        let running = main_loop.clone();
+        let thread = std::thread::spawn(move || running.run());
+        let producer = tokio::spawn(async move {
+            if let Some(mut client) = clients.recv().await {
+                let source = client.vid.take().unwrap().app;
+                let (tx, rx) = mpsc(8);
+                let worker = tokio::spawn(async move { handle_data(Some(&source), tokio_stream::wrappers::ReceiverStream::new(rx)).await });
+                for n in 0..160u64 {
+                    if tx.send(Ok::<_, ()>(StreamData::Media { data: frame.clone(), ts: Duration::from_millis(n * 50) })).await.is_err() { break; }
+                    sleep(Duration::from_millis(50)).await;
+                }
+                drop(tx); let _ = worker.await;
+            }
+        });
+        let player = std::env::var("HOMECAM_MPV")?;
+        let url = format!("rtsp://127.0.0.1:{port}/test");
+        let result = tokio::task::spawn_blocking(move || {
+            std::process::Command::new(player).args(["--no-config", "--vo=null", "--no-audio", "--no-input-terminal",
+                "--profile=low-latency", "--cache=no", "--demuxer-lavf-o-add=rtsp_transport=tcp", "--frames=40", &url]).output()
+        }).await?;
+        main_loop.quit(); id.remove(); thread.join().unwrap(); producer.abort();
+        let output = result?;
+        let text = format!("{}{}", String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+        assert!(output.status.success(), "mpv RTSP failed: {:?}", output);
+        assert!(text.contains("Video") && text.contains("End of file"), "mpv did not decode the RTSP video: {}", text);
+        println!("Production live RTSP factory: actual mpv decoded 40 frames over loopback TCP");
+        Ok(())
+    }
+}
