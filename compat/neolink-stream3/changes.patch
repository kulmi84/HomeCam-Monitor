+                response_code: 200, msg_num: 0, class: 0x6414 },
+            body: BcBody::ModernMsg(ModernMsg { extension: None, payload: Some(BcPayloads::Binary(vec![1, 2, 3])) }),
+        }
+    }
+    #[tokio::test]
+    async fn legacy_video_routes_binary_to_the_only_open_consumer() {
+        let (sender, mut receiver) = channel(1);
