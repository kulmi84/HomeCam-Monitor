+fn legacy_video_sender(response: &Bc, consumers: &BTreeMap<Option<u16>, Sender<Result<Bc>>>) -> Option<Sender<Result<Bc>>> {
+    if response.meta.msg_id != MSG_ID_VIDEO || response.meta.channel_id != 0 ||
+        !matches!(&response.body, BcBody::ModernMsg(ModernMsg { payload: Some(BcPayloads::Binary(_)), .. })) {
+        return None;
+    }
+    let mut active = consumers.values().filter(|sender| !sender.is_closed());
+    let sender = active.next()?.clone();
+    if active.next().is_some() { None } else { Some(sender) }
+}
