+#[cfg(test)]
+mod ack_receive_rate_tests {
+    use super::*;
+    #[test]
+    fn ack_receive_rate_updates_once_per_second_and_resets_window() {
+        let start = Instant::now();
+        let mut rate = AckReceiveRate::default();
+        rate.feed_data_at(600, start);
+        rate.feed_data_at(400, start + Duration::from_millis(500));
+        assert_eq!(rate.get_value(), 0);
+        rate.feed_data_at(1000, start + Duration::from_secs(1));
+        assert_eq!(rate.get_value(), 2000);
+        rate.feed_data_at(500, start + Duration::from_secs(2));
+        assert_eq!(rate.get_value(), 500);
+    }
+    #[test]
+    fn ack_receive_rate_uses_actual_elapsed_time() {
+        let start = Instant::now();
+        let mut rate = AckReceiveRate::default();
+        rate.feed_data_at(1000, start);
+        rate.feed_data_at(0, start + Duration::from_secs(2));
+        assert_eq!(rate.get_value(), 500);
+    }
+    #[test]
+    fn ack_receive_rate_saturates_protocol_field() {
+        let start = Instant::now();
+        let mut rate = AckReceiveRate::default();
+        rate.feed_data_at(usize::MAX, start);
+        rate.feed_data_at(usize::MAX, start + Duration::from_secs(1));
+        assert_eq!(rate.get_value(), u32::MAX);
+    }
+}
